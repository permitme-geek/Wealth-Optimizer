# ─────────────────────────────────────────────────────────────
# WealthOS — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Paystack (income & business transactions) ──────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Use LIVE key for real data, TEST key for sandbox
PAYSTACK_SECRET_KEY=sk_live_your_key_here

# ── Your financial parameters ──────────────────────────────────
# Used as fallback if API connection fails, and for assets not in Mono
HYSA_YIELD_RATE=0.105          # 10.5% annual — update with your actual Wema rate
MONTHLY_INCOME_ESTIMATE=850000  # ₦ — used until Paystack provides real data
MONTHLY_EXPENSE_ESTIMATE=350000 # ₦ — updated from Mono transaction history
RISK_TOLERANCE=2.5              # 1.0=aggressive, 2.5=moderate, 4.0=conservative
INFLATION_RATE=0.30             # 30% Nigerian CPI — adjust to current CBN figure

# ── Manual investment positions (not in Mono) ──────────────────
EQUITIES_VALUE=2000000          # ₦ NSE equities (update with your actual value)
BONDS_VALUE=1000000             # ₦ FGN bonds
MONEY_MARKET_VALUE=1500000      # ₦ money market / T-bills
OTHER_ASSETS_VALUE=500000       # ₦ other investments

# ── Wealth goal ────────────────────────────────────────────────
WEALTH_GOAL=50000000            # ₦ target net worth
GOAL_HORIZON_MONTHS=60          # 5-year horizon
MONTHLY_INCOME_TARGET=0         # personal monthly income KPI
WEALTHOS_TIMEZONE=Africa/Lagos  # daily report timezone
VOICE_REMINDERS=true            # speak daily status and next action on macOS

# ── Optional daily email brief (configure with `python cli.py setup`) ─────────
REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── System ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///wealthos.db
RISK_FREE_RATE=0.14             # Nigerian T-bill rate
